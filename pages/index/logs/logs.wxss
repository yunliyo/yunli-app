/**pages/index/logs/logs.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  font-family: "SimSun", "宋体", serif;
}

navigation-bar {
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 名片卡片 */
.card {
  margin: 24rpx;
  padding: 44rpx 40rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

/* 头部 */
.card-header {
  display: flex;
  align-items: center;
}

.avatar {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  margin-right: 32rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.header-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 42rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.bio {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #9b9b9b;
  letter-spacing: 1rpx;
}

/* 座右铭 */
.motto {
  margin-top: 36rpx;
  padding: 22rpx 16rpx;
  background: #efefef;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #6b6b6b;
  letter-spacing: 3rpx;
  text-align: center;
}

/* 信息列表 */
.field-list {
  margin-top: 30rpx;
}

.field-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  font-size: 30rpx;
}

.field-item--hover {
  background: #f7f7f7;
}

.field-icon {
  flex: none;
  margin-right: 14rpx;
}

.field-label {
  flex: none;
  width: 108rpx;
  margin-right: 8rpx;
  color: #5a5a5a;
  letter-spacing: 1rpx;
}

.field-value {
  flex: 1;
  min-width: 0;
  color: #2b2b2b;
  word-break: break-all;
}

.field-value--link {
  color: #8d4bbb;
}

/* 操作按钮 */
.action-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.action-btn {
  padding: 0 72rpx;
  font-size: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}
